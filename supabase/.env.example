# Archivo: /supabase/.env.example
# Plantilla de secretos para las Edge Functions. Copia a supabase/.env,
# rellena los valores reales y súbelos con: supabase secrets set --env-file supabase/.env
# JAMÁS versionar supabase/.env (ya está en .gitignore).

# Bold (https://developers.bold.co)
BOLD_API_KEY=TU_LLAVE_DE_IDENTIDAD_BOLD
BOLD_SECRET_KEY=TU_LLAVE_SECRETA_BOLD
# SOLO PRUEBAS: acepta webhooks de Bold sin firma verificada. JAMÁS en producción.
# BOLD_WEBHOOK_ALLOW_UNSIGNED=true

# MercadoPago (https://www.mercadopago.com.co/developers)
MP_ACCESS_TOKEN=TU_ACCESS_TOKEN_MERCADOPAGO
MP_WEBHOOK_SECRET=TU_CLAVE_SECRETA_WEBHOOK_MERCADOPAGO
# SOLO PRUEBAS: acepta webhooks de MercadoPago sin MP_WEBHOOK_SECRET. JAMÁS en producción.
# MP_WEBHOOK_ALLOW_UNSIGNED=true

# Dropi (token pendiente de entrega junto con la documentación oficial)
DROPI_API_TOKEN=TU_TOKEN_DROPI
# Reservada para la integración real de Dropi (hoy ningún código la lee)
# DROPI_API_URL=https://TU_URL_API_DROPI

# Supabase: secret key (equivalente moderno del service_role).
# Rotar la que se compartió en el chat antes de configurar esto.
SB_SECRET_KEY=TU_SUPABASE_SECRET_KEY

# URL pública del sitio (GitHub Pages o dominio propio) para redirecciones de pago
PUBLIC_SITE_URL=https://goatdev00.github.io/StockiWEB
